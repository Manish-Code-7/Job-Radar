# ---------- Core ----------
DATABASE_URL=postgres://jobradar:jobradar@localhost:5432/jobradar
POSTGRES_PASSWORD=change-me
# Local only, if something else already uses 5432 on your machine:
# PG_HOST_PORT=5433
# Build for the Oracle Arm VM (default). On an x86 laptop you may set linux/amd64 for faster local builds.
PLATFORM=linux/arm64

# ---------- Crawler identity ----------
# Public page that explains the bot and how to contact you / opt out. Goes in the User-Agent.
CRAWL_CONTACT_URL=https://your-domain.example/bot

# ---------- Auth (Better Auth) ----------
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=you@example.com

# ---------- GitHub Actions crawl pool ----------
# ≥ 24 random chars. Same value in the GitHub repo secret INGEST_TOKEN.
INGEST_TOKEN=generate-with-openssl-rand-hex-24

# ---------- AI ----------
# Optional. Gemini free tier is used ONLY for public job postings, never resumes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_REQUESTS=200
GEMINI_RPM=10
# Local resume parsing (Phase 2): docker compose --profile ai up -d
OLLAMA_URL=http://ollama:11434
# Local CPU embeddings (bge-small, 384-d). Set to off to skip.
EMBEDDINGS=on

# ---------- Free-tier "heavy tools" (budget-routed) ----------
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_CREDITS=1000
APIFY_TOKEN=
# A pay-per-result ATS scraper actor that accepts {queries, location, keywords, postedWithinDays, maxJobsPerCompany}
APIFY_ATS_ACTOR_ID=
APIFY_MONTHLY_USD=5

# ---------- Alerts (Phase 3) ----------
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Job Radar <alerts@your-domain.example>

# ---------- Backups to Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=job-radar-backups

# ---------- Cloudflare Tunnel ----------
CLOUDFLARE_TUNNEL_TOKEN=
