# ---------- Neon (written by `neon deploy` / `neon env pull`; do not hand-edit) ----------
# Postgres: pooled URL for app traffic, direct URL for migrations, pg-boss and pg_dump.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=
# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon Realtime (the secret seals live queries: server only, never ship it to the browser)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# Neon AI Gateway (needs prepaid AI Gateway credits on the Neon Billing page)
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# ---------- App config you set yourself ----------
# Signs Neon Auth's cached session cookie (not provided by Neon): openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Build target for the Oracle Arm VM (default). On an x86 laptop you may set linux/amd64.
PLATFORM=linux/arm64
# Optional offline database: docker compose --profile localdb up -d postgres
# POSTGRES_PASSWORD=change-me
# PG_HOST_PORT=5433

# ---------- Crawler identity ----------
# Public page that explains the bot and how to contact you / opt out. Goes in the User-Agent.
CRAWL_CONTACT_URL=https://your-domain.example/bot

# ---------- Admin ----------
# Comma-separated emails allowed into /admin (sign in with email OTP or Google via Neon Auth)
ADMIN_EMAILS=you@example.com

# ---------- GitHub Actions crawl pool ----------
# ≥ 24 random chars. Same value in the GitHub repo secret INGEST_TOKEN.
INGEST_TOKEN=generate-with-openssl-rand-hex-24

# ---------- AI ----------
# Job-text AI uses the Neon AI Gateway when NEON_AI_GATEWAY_TOKEN is set (model below);
# otherwise the Gemini free tier if GEMINI_API_KEY is set; otherwise rules only.
# Public job postings only, never resumes.
AI_GATEWAY_MODEL=gemini-3-5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_DAILY_REQUESTS=200
GEMINI_RPM=10
# Local resume parsing (Phase 2): docker compose --profile ai up -d
OLLAMA_URL=http://ollama:11434
# Local CPU embeddings (bge-small, 384-d). Set to off to skip.
EMBEDDINGS=on

# ---------- Free-tier "heavy tools" (budget-routed) ----------
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_CREDITS=1000
APIFY_TOKEN=
# A pay-per-result ATS scraper actor that accepts {queries, location, keywords, postedWithinDays, maxJobsPerCompany}
APIFY_ATS_ACTOR_ID=
APIFY_MONTHLY_USD=5

# ---------- Alerts (Phase 3) ----------
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Job Radar <alerts@your-domain.example>

# ---------- Backups to Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=job-radar-backups

# ---------- Cloudflare Tunnel ----------
CLOUDFLARE_TUNNEL_TOKEN=
